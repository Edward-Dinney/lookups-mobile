{
  "expo": {
    "name": "Lookups",
    "slug": "lookups",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "lookups",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.edwarddinney.lookups"
    },
    "android": {
      "package": "com.edwarddinney.lookups",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Lookups saves album covers to your photo library.",
          "photosPermission": "Lookups saves album covers to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-image"
    ]
  }
}
